{
  "name": "01-done",
  "why": "Report says the invocation finished: the log ends with INSTRUMENTATION_CODE: -1, so the guard must classify DONE and exit 0 (and must not touch the run).",
  "args": { "StaleMinutes": 1, "PollSeconds": 15, "Seconds": 600 },
  "expectExit": 0,
  "expectReport": ["^DONE .*run finished normally \\(INSTRUMENTATION_CODE: -1\\); guards stop"],
  "expectNoReport": ["^CRASH ", "^UNKNOWN ", "^WATCHDOG ", "^FREEZER ", "^PROBE-UNKNOWN "],
  "expectCommands": [],
  "steps": [
    { "pidof": "21272", "ps": "ps-not-frozen-constructed.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-not-frozen-constructed.txt", "log": "log-done.txt" }
  ]
}
