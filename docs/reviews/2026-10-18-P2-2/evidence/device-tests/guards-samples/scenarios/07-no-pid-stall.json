{
  "name": "07-no-pid-stall",
  "why": "`adb shell pidof` returns nothing while the log is stuck. A process that is not there cannot be called frozen, but it also must not be called a normal finish: probe=NO_PID must end as UNKNOWN/exit 5.",
  "args": { "StaleMinutes": 1, "PollSeconds": 15, "Seconds": 600 },
  "expectExit": 5,
  "expectReport": [
    "^WATCHDOG .*probe=NO_PID",
    "^VERDICT UNKNOWN exit=5 probe=NO_PID"
  ],
  "expectNoReport": ["run finished normally", "^DONE ", "^FREEZER ", "^PROBE-UNKNOWN "],
  "expectCommands": ["force-stop com.xavierxia.mycelium.debug"],
  "steps": [
    { "pidof": "", "log": "log-running.txt" },
    { "pidof": "", "log": "log-running.txt" },
    { "pidof": "", "log": "log-running.txt" },
    { "pidof": "", "log": "log-running.txt" },
    { "pidof": "", "log": "log-running.txt" },
    { "pidof": "", "log": "log-running.txt" }
  ]
}
