{
  "name": "10-ps-error",
  "why": "pidof finds the target but the `ps` call fails (adb/run-as error text instead of a thread table). An unreadable probe must be reported and must end as UNKNOWN/exit 5, not as `not frozen`.",
  "args": { "StaleMinutes": 1, "PollSeconds": 15, "Seconds": 600 },
  "expectExit": 5,
  "expectReport": [
    "^PROBE-UNKNOWN .*reason=ps header has no WCHAN column",
    "^WATCHDOG .*probe=UNKNOWN",
    "^VERDICT UNKNOWN exit=5 probe=UNKNOWN"
  ],
  "expectNoReport": ["run finished normally", "^DONE ", "^FREEZER ", "probe=NOT_FROZEN"],
  "expectCommands": ["force-stop com.xavierxia.mycelium.debug.test"],
  "steps": [
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" },
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" },
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" },
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" },
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" },
    { "pidof": "21272", "psError": "error: closed", "log": "log-running.txt" }
  ]
}
