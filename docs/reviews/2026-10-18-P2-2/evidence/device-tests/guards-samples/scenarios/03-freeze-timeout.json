{
  "name": "03-freeze-timeout",
  "why": "Real ps -T excerpt: every thread of the instrumentation process sits in do_freezer_trap and the log stops growing. The guard must unfreeze once, then classify FREEZE_TIMEOUT (exit 3) instead of staying silent.",
  "args": { "StaleMinutes": 1, "PollSeconds": 15, "Seconds": 600 },
  "expectExit": 3,
  "expectReport": [
    "^FREEZER .*pid=21272 all 5 threads in do_freezer_trap -> am unfreeze --sticky",
    "^WATCHDOG .*probe=FROZEN.*freeze attempts=1",
    "^VERDICT FREEZE_TIMEOUT exit=3 probe=FROZEN"
  ],
  "expectNoReport": ["run finished normally", "^DONE ", "^PROBE-UNKNOWN "],
  "expectCommands": [
    "unfreeze --sticky com.xavierxia.mycelium.debug",
    "force-stop com.xavierxia.mycelium.debug",
    "force-stop com.xavierxia.mycelium.debug.test"
  ],
  "steps": [
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" },
    { "pidof": "21272", "ps": "ps-frozen-5-threads.txt", "log": "log-running.txt" }
  ]
}
